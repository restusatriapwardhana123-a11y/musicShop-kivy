#:import dp kivy.metrics.dp


<LoginScreen>:

    canvas.before:
        Color:
            rgba: 0.025, 0.035, 0.075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(12)

        Widget:
            size_hint_y: 0.08

        Label:
            text: "M U S I C  S H O P"
            font_size: "32sp"
            bold: True
            color: 0.30, 0.70, 1, 1
            size_hint_y: None
            height: dp(55)

        Label:
            text: "PREMIUM MUSICAL INSTRUMENTS"
            font_size: "14sp"
            bold: True
            color: 0.65, 0.75, 0.90, 1
            size_hint_y: None
            height: dp(30)

        Label:
            text: "Temukan Instrument Untuk Musikmu"
            font_size: "17sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(10)
            padding: 0, dp(20)

        Label:
            text: "Temukan pilihan alat musik berkualitas untuk\nmendukung setiap nada, karya, dan perjalanan musikmu."
            font_size: "12sp"
            color: 0.60, 0.67, 0.78, 1
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: dp(45)

        Widget:
            size_hint_y: 0.04

        Label:
            text: "MEMBER ACCESS"
            font_size: "21sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(40)

        TextInput:
            id: username
            hint_text: "Masukkan username"
            multiline: False
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.10, 0.13, 0.22, 1
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.50, 0.55, 0.65, 1
            padding: dp(14), dp(12)

        Button:
            text: "HAPUS"
            size_hint_y: None
            height: dp(32)
            background_normal: ""
            background_color: 0.15, 0.18, 0.28, 1
            color: 0.70, 0.80, 0.95, 1
            font_size: "11sp"
            on_press:
                root.hapus_username()

        TextInput:
            id: password
            hint_text: "Masukkan password"
            password: True
            multiline: False
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.10, 0.13, 0.22, 1
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.50, 0.55, 0.65, 1
            padding: dp(14), dp(12)

        Button:
            text: "LIHAT"
            size_hint_y: None
            height: dp(32)
            background_normal: ""
            background_color: 0.15, 0.18, 0.28, 1
            color: 0.70, 0.80, 0.95, 1
            font_size: "11sp"
            on_press:
                root.toggle_password()

        Button:
            text: "MASUK KE MUSIC SHOP"
            size_hint_y: None
            height: dp(52)
            background_normal: ""
            background_color: 0.15, 0.55, 0.90, 1
            color: 1, 1, 1, 1
            bold: True
            font_size: "14sp"
            on_press:
                root.login()


<WelcomeScreen>:

    canvas.before:
        Color:
            rgba: 0.025, 0.035, 0.075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(20)

        Widget:
            size_hint_y: 0.20

        Label:
            text: "SELAMAT DATANG"
            font_size: "32sp"
            bold: True
            color: 0.30, 0.70, 1, 1
            size_hint_y: None
            height: dp(55)

        Label:
            text: "DI MUSIC SHOP"
            font_size: "25sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(50)

        Label:
            text: "Exclusive instruments • Quality sound • Your music"
            font_size: "13sp"
            color: 0.60, 0.70, 0.85, 1
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: dp(40)

        Widget:
            size_hint_y: 0.20

        Button:
            text: "MULAI BELANJA"
            size_hint_y: None
            height: dp(55)
            background_normal: ""
            background_color: 0.15, 0.55, 0.90, 1
            color: 1, 1, 1, 1
            bold: True
            font_size: "15sp"
            on_press:
                app.root.current = "product"

        Button:
            text: "KEMBALI KE LOGIN"
            size_hint_y: None
            height: dp(45)
            background_normal: ""
            background_color: 0.15, 0.18, 0.28, 1
            color: 0.70, 0.80, 0.95, 1
            bold: True
            font_size: "12sp"
            on_press:
                app.root.current = "login"

        Widget:
            size_hint_y: 0.20


<ProductScreen>:

    canvas.before:
        Color:
            rgba: 0.025, 0.035, 0.075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(30)
        spacing: dp(15)

        Widget:
            size_hint_y: 1

        Label:
            text: "PILIH PRODUK"
            font_size: "20sp"
            bold: True
            color: 0.30, 0.70, 1, 1
            size_hint_y: None
            height: dp(60)

        Button:
            text: "GUITAR"
            size_hint_y: None
            height: dp(55)
            on_press:
                root.pilih_produk("Guitar")

        Button:
            text: "PIANO"
            size_hint_y: None
            height: dp(55)
            on_press:
                root.pilih_produk("Piano")

        Button:
            text: "DRUM"
            size_hint_y: None
            height: dp(55)
            on_press:
                root.pilih_produk("Drum")

        Button:
            text: "KEMBALI"
            size_hint_y: None
            height: dp(45)
            on_press:
                app.root.current = "welcome"

        Widget:
            size_hint_y: 1


<DetailScreen>:

    canvas.before:
        Color:
            rgba: 0.025, 0.035, 0.075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(30)
        spacing: dp(12)

        Widget:
            size_hint_y: 0.10

        Label:
            text: "PILIH MEREK " + root.nama_produk.upper()
            font_size: "25sp"
            bold: True
            color: 0.30, 0.70, 1, 1
            size_hint_y: None
            height: dp(50)

        Label:
            text: "Pilih salah satu merek"
            font_size: "13sp"
            color: 0.60, 0.70, 0.85, 1
            size_hint_y: None
            height: dp(30)

        Button:
            text: "FENDER" if root.nama_produk == "Guitar" else ("YAMAHA" if root.nama_produk == "Piano" else "PEARL")
            size_hint_y: None
            height: dp(45)
            on_press:
                root.pilih_merek(self.text)

        Button:
            text: "GIBSON" if root.nama_produk == "Guitar" else ("ROLAND" if root.nama_produk == "Piano" else "TAMA")
            size_hint_y: None
            height: dp(45)
            on_press:
                root.pilih_merek(self.text)

        Button:
            text: "IBANEZ" if root.nama_produk == "Guitar" else ("KAWAI" if root.nama_produk == "Piano" else "YAMAHA")
            size_hint_y: None
            height: dp(45)
            on_press:
                root.pilih_merek(self.text)

        Button:
            text: "PRS" if root.nama_produk == "Guitar" else ("CASIO" if root.nama_produk == "Piano" else "LUDWIG")
            size_hint_y: None
            height: dp(45)
            on_press:
                root.pilih_merek(self.text)

        Button:
            text: "YAMAHA" if root.nama_produk == "Guitar" else ("STEINWAY & SONS" if root.nama_produk == "Piano" else "DW")
            size_hint_y: None
            height: dp(45)
            on_press:
                root.pilih_merek(self.text)

        Label:
            text: "Merek dipilih: " + root.merek_dipilih if root.merek_dipilih else "Belum memilih merek"
            font_size: "13sp"
            color: 0.70, 0.80, 0.95, 1
            size_hint_y: None
            height: dp(30)

        Button:
            text: "TAMBAH KE KERANJANG"
            size_hint_y: None
            height: dp(52)
            background_normal: ""
            background_color: 0.15, 0.55, 0.90, 1
            color: 1, 1, 1, 1
            bold: True
            on_press:
                root.tambah_keranjang()

        Button:
            text: "KEMBALI KE PRODUK"
            size_hint_y: None
            height: dp(42)
            background_normal: ""
            background_color: 0.15, 0.18, 0.28, 1
            color: 0.70, 0.80, 0.95, 1
            on_press:
                app.root.current = "product"

        Widget:
            size_hint_y: 0.10


<CartScreen>:

    canvas.before:
        Color:
            rgba: 0.025, 0.035, 0.075, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(40)
        spacing: dp(20)

        Widget:
            size_hint_y: 0.25

        Label:
            text: "PEMBELIAN BERHASIL"
            font_size: "30sp"
            bold: True
            color: 0.30, 0.70, 1, 1
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: dp(60)

        Label:
            text: root.nama_produk + " - " + root.merek_produk
            font_size: "20sp"
            bold: True
            color: 1, 1, 1, 1
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: dp(45)

        Label:
            text: "Produk berhasil ditambahkan ke keranjang."
            font_size: "13sp"
            color: 0.60, 0.70, 0.85, 1
            halign: "center"
            text_size: self.width, None
            size_hint_y: None
            height: dp(40)

        Widget:
            size_hint_y: 0.15

        Button:
            text: "KEMBALI KE PRODUK"
            size_hint_y: None
            height: dp(50)
            background_normal: ""
            background_color: 0.15, 0.55, 0.90, 1
            color: 1, 1, 1, 1
            bold: True
            on_press:
                app.root.current = "product"

        Button:
            text: "KEMBALI KE LOGIN"
            size_hint_y: None
            height: dp(45)
            background_normal: ""
            background_color: 0.15, 0.18, 0.28, 1
            color: 0.70, 0.80, 0.95, 1
            on_press:
                app.root.current = "login"

        Widget:
            size_hint_y: 0.25
