#:import dp kivy.metrics.dp

<LoginScreen>:
    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.16, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(35)
        spacing: dp(18)

        Label:
            text: "MUSIC SHOP"
            font_size: "34sp"
            bold: True
            color: 0.35, 0.85, 1, 1
            size_hint_y: None
            height: dp(80)

        Label:
            text: "Temukan instrumen untuk musikmu"
            font_size: "16sp"
            color: 0.75, 0.78, 0.85, 1
            size_hint_y: None
            height: dp(35)

        Widget:
            size_hint_y: 0.3

        Label:
            text: "LOGIN"
            font_size: "24sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(50)

        TextInput:
            hint_text: "Masukkan username"
            multiline: False
            size_hint_y: None
            height: dp(48)
            background_color: 0.15, 0.18, 0.28, 1
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.65, 0.68, 0.75, 1
            padding: dp(12), dp(12)

        TextInput:
            hint_text: "Masukkan password"
            password: True
            multiline: False
            size_hint_y: None
            height: dp(48)
            background_color: 0.15, 0.18, 0.28, 1
            foreground_color: 1, 1, 1, 1
            hint_text_color: 0.65, 0.68, 0.75, 1
            padding: dp(12), dp(12)

        Button:
            text: "MASUK KE MUSIC SHOP"
            size_hint_y: None
            height: dp(52)
            background_normal: ""
            background_color: 0.20, 0.65, 0.95, 1
            bold: True
            font_size: "16sp"
            on_press:
                app.root.current = "home"

        Widget:
            size_hint_y: 0.4


<HomeScreen>:
    canvas.before:
        Color:
            rgba: 0.08, 0.10, 0.20, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(35)
        spacing: dp(20)

        Label:
            text: "MUSIC SHOP"
            font_size: "32sp"
            bold: True
            color: 0.95, 0.45, 0.75, 1
            size_hint_y: None
            height: dp(65)

        Label:
            text: "Selamat Datang!"
            font_size: "26sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(55)

        Label:
            text: "Pilih alat musik favoritmu dan mulai perjalanan musikalmu."
            font_size: "16sp"
            color: 0.75, 0.78, 0.85, 1
            text_size: self.width, None
            halign: "center"
            size_hint_y: None
            height: dp(70)

        Widget:
            size_hint_y: 0.3

        Button:
            text: "🎵  LIHAT PRODUK"
            size_hint_y: None
            height: dp(60)
            background_normal: ""
            background_color: 0.55, 0.30, 0.90, 1
            bold: True
            font_size: "18sp"
            on_press:
                app.root.current = "product"

        Button:
            text: "KELUAR / KEMBALI KE LOGIN"
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.22, 0.25, 0.38, 1
            font_size: "15sp"
            on_press:
                app.root.current = "login"

        Widget:
            size_hint_y: 0.5


<ProductScreen>:
    canvas.before:
        Color:
            rgba: 0.07, 0.08, 0.15, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(30)
        spacing: dp(18)

        Label:
            text: "DAFTAR PRODUK"
            font_size: "30sp"
            bold: True
            color: 1, 0.70, 0.25, 1
            size_hint_y: None
            height: dp(65)

        Label:
            text: "Pilih instrumen yang ingin kamu lihat"
            font_size: "16sp"
            color: 0.70, 0.72, 0.80, 1
            size_hint_y: None
            height: dp(40)

        Button:
            text: "🎸   GITAR AKUSTIK"
            size_hint_y: None
            height: dp(65)
            background_normal: ""
            background_color: 0.85, 0.30, 0.35, 1
            bold: True
            font_size: "18sp"
            on_press:
                root.pilih_produk("Gitar Akustik")

        Button:
            text: "🎹   KEYBOARD"
            size_hint_y: None
            height: dp(65)
            background_normal: ""
            background_color: 0.25, 0.55, 0.90, 1
            bold: True
            font_size: "18sp"
            on_press:
                root.pilih_produk("Keyboard")

        Button:
            text: "🥁   DRUM"
            size_hint_y: None
            height: dp(65)
            background_normal: ""
            background_color: 0.65, 0.35, 0.85, 1
            bold: True
            font_size: "18sp"
            on_press:
                root.pilih_produk("Drum")

        Widget:

        Button:
            text: "← KEMBALI"
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.22, 0.24, 0.35, 1
            on_press:
                app.root.current = "home"


<DetailScreen>:
    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.14, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(35)
        spacing: dp(20)

        Label:
            text: "DETAIL PRODUK"
            font_size: "30sp"
            bold: True
            color: 0.30, 0.90, 0.75, 1
            size_hint_y: None
            height: dp(70)

        Label:
            text: root.nama_produk
            font_size: "28sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(100)

        Label:
            text: "Produk pilihanmu siap ditambahkan ke keranjang."
            font_size: "16sp"
            color: 0.70, 0.73, 0.82, 1
            size_hint_y: None
            height: dp(50)

        Label:
            id: status
            text: "Silakan tambahkan produk ke keranjang"
            font_size: "15sp"
            color: 1, 0.80, 0.35, 1
            text_size: self.width, None
            halign: "center"
            size_hint_y: None
            height: dp(70)

        Widget:

        Button:
            text: "🛒  TAMBAHKAN KE KERANJANG"
            size_hint_y: None
            height: dp(60)
            background_normal: ""
            background_color: 0.15, 0.70, 0.50, 1
            bold: True
            font_size: "16sp"
            on_press:
                root.tambah_keranjang()

        Button:
            text: "← KEMBALI KE PRODUK"
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.22, 0.24, 0.35, 1
            on_press:
                app.root.current = "product"


<CartScreen>:
    canvas.before:
        Color:
            rgba: 0.06, 0.08, 0.14, 1
        Rectangle:
            pos: self.pos
            size: self.size

    BoxLayout:
        orientation: "vertical"
        padding: dp(35)
        spacing: dp(20)

        Label:
            text: "KERANJANG BELANJA"
            font_size: "30sp"
            bold: True
            color: 0.30, 0.90, 0.75, 1
            size_hint_y: None
            height: dp(70)

        Label:
            text: "Produk yang kamu pilih:"
            font_size: "17sp"
            color: 0.70, 0.73, 0.82, 1
            size_hint_y: None
            height: dp(40)

        Label:
            text: root.nama_produk
            font_size: "28sp"
            bold: True
            color: 1, 1, 1, 1
            size_hint_y: None
            height: dp(100)

        Label:
            text: "Produk berhasil ditambahkan ke keranjang!"
            font_size: "16sp"
            color: 1, 0.80, 0.35, 1

        Widget:

        Button:
            text: "← LANJUT BELANJA"
            size_hint_y: None
            height: dp(55)
            background_normal: ""
            background_color: 0.25, 0.55, 0.90, 1
            bold: True
            on_press:
                app.root.current = "product"

        Button:
            text: "KEMBALI KE HOME"
            size_hint_y: None
            height: dp(48)
            background_normal: ""
            background_color: 0.22, 0.24, 0.35, 1
            on_press:
                app.root.current = "home"


